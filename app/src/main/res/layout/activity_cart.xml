<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/cartCount" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="20sp" />
    <Button android:id="@+id/checkoutButton" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Checkout" />
    <TextView android:id="@+id/orderConfirmation" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="20sp" />
</LinearLayout>